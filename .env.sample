# 复制为 .env 并填入真实值（.env 不要提交到仓库）
# 使用任意 OpenAI 兼容接口；本系列实测用阿里云百炼，第六、七篇需要，第二至四篇不需要
# 第八、九篇的本地协议验证也不需要 LLM；平台 LLM 扩展需在平台侧另配
# 百炼北京地域示例（workspaceId 以控制台为准）：
#   LLM_BASE_URL=https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 密钥申请：阿里云百炼控制台 → API-KEY 管理
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
# 模型由你自行选择：填控制台里可用的模型名。
# 免费额度耗尽通常返回 403 insufficient_quota，换模型后重启即可。
# 可先运行 `uv run python scripts/check_llm.py` 探测当前配置。
LLM_MODEL=your-model-name
LLM_API_KEY=<your-dashscope-api-key>
# 仅当模型名含 qwen 时发送；其他模型不发送该字段
LLM_ENABLE_THINKING=false

# 第五至七篇地址配置：
# BIND_HOST 是 uvicorn 监听地址；容器内用 0.0.0.0
# A2A_HOST 是客户端连接与名片广播地址；跨机时改成对端可达的 IP/域名
# PUBLIC_URL_TEMPLATE 可选，含 {port}，反代/公网时覆盖名片地址
BIND_HOST=127.0.0.1
A2A_HOST=127.0.0.1
# PUBLIC_URL_TEMPLATE=http://your-host:{port}
# 跨机器且各智能体地址不同时，使用独立 URL（优先级高于模板）：
# POLICY_AGENT_URL=http://policy-host:9999
# PROVIDER_AGENT_URL=http://provider-host:9997
# RESEARCH_AGENT_URL=http://research-host:9998
# HEALTHCARE_AGENT_URL=http://healthcare-host:9996

# 第七篇导诊同轮并行分发上限（免费额度紧张时改成 1）
MAX_PARALLEL_TOOL_CALLS=2

# 第六、七篇各智能体端口（与 article04_agents/common.py 的读取名一致）
POLICY_AGENT_PORT=9999
RESEARCH_AGENT_PORT=9998
PROVIDER_AGENT_PORT=9997
HEALTHCARE_AGENT_PORT=9996

# 第八、九篇 Agent Stack 本地运行（Docker/平台部署时由运行环境覆盖）：
# HOST=0.0.0.0
# PORT=8000
# PUBLIC_URL=http://your-host:8000